{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Glaze website (glaze-os.com): private S3, CloudFront OAC, DNS-validated ACM and Route 53 aliases for the apex and www. Deploy in us-east-1.",
  "Parameters": {
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id",
      "Description": "Existing public hosted zone for glaze-os.com; do not create another zone."
    },
    "DomainName": {
      "Type": "String",
      "Default": "glaze-os.com",
      "AllowedPattern": "[a-z0-9.-]+",
      "Description": "The site's apex domain; www.<domain> redirects to it."
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "glaze-os-site-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 90
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze website"
          }
        ]
      }
    },
    "SiteCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Ref": "DomainName"
        },
        "SubjectAlternativeNames": [
          {
            "Fn::Sub": "www.${DomainName}"
          }
        ],
        "ValidationMethod": "DNS",
        "KeyAlgorithm": "RSA_2048",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Ref": "DomainName"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          },
          {
            "DomainName": {
              "Fn::Sub": "www.${DomainName}"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze website"
          }
        ]
      }
    },
    "SiteOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4",
          "Description": "CloudFront-only access to the private website objects."
        }
      }
    },
    "SiteRouting": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-routing"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Redirect www to the apex; serve index.html for directory URLs.",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n    var request = event.request;\n    var host = request.headers.host ? request.headers.host.value : '';\n    if (host.indexOf('www.') === 0) {\n        return {\n            statusCode: 301,\n            statusDescription: 'Moved Permanently',\n            headers: { location: { value: 'https://' + host.slice(4) + request.uri } }\n        };\n    }\n    var uri = request.uri;\n    if (uri.endsWith('/')) {\n        request.uri = uri + 'index.html';\n    } else if (uri.split('/').pop().indexOf('.') < 0) {\n        request.uri = uri + '/index.html';\n    }\n    return request;\n}\n"
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Glaze website",
          "Aliases": [
            {
              "Ref": "DomainName"
            },
            {
              "Fn::Sub": "www.${DomainName}"
            }
          ],
          "DefaultRootObject": "index.html",
          "IPV6Enabled": true,
          "HttpVersion": "http2and3",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "SiteS3",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "SiteOriginAccessControl"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "SiteS3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "SiteRouting",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "SiteCertificate"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze website"
          }
        ]
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "CloudFrontListForNotFound",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SiteBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SiteDns": {
      "Type": "AWS::Route53::RecordSetGroup",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Comment": "Glaze website CDN",
        "RecordSets": [
          {
            "Name": {
              "Ref": "DomainName"
            },
            "Type": "A",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "SiteDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          },
          {
            "Name": {
              "Ref": "DomainName"
            },
            "Type": "AAAA",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "SiteDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          },
          {
            "Name": {
              "Fn::Sub": "www.${DomainName}"
            },
            "Type": "A",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "SiteDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          },
          {
            "Name": {
              "Fn::Sub": "www.${DomainName}"
            },
            "Type": "AAAA",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "SiteDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "SiteDistribution"
      }
    },
    "DistributionDomainName": {
      "Value": {
        "Fn::GetAtt": [
          "SiteDistribution",
          "DomainName"
        ]
      }
    },
    "SiteUrl": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "CertificateArn": {
      "Value": {
        "Ref": "SiteCertificate"
      }
    }
  }
}
