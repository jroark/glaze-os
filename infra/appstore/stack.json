{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Glaze App Store: private S3, CloudFront OAC, DNS-validated ACM and Route 53 aliases. Deploy in us-east-1.",
  "Parameters": {
    "HostedZoneId": {
      "Type": "AWS::Route53::HostedZone::Id",
      "Description": "Existing public hosted zone for glaze-os.com; do not create another zone."
    },
    "DomainName": {
      "Type": "String",
      "Default": "appstore.glaze-os.com",
      "AllowedPattern": "[a-z0-9.-]+",
      "Description": "App Store hostname within the existing public zone."
    }
  },
  "Resources": {
    "StoreBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "glaze-os-appstore-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze App Store"
          }
        ]
      }
    },
    "StoreCertificate": {
      "Type": "AWS::CertificateManager::Certificate",
      "Properties": {
        "DomainName": {
          "Ref": "DomainName"
        },
        "ValidationMethod": "DNS",
        "KeyAlgorithm": "RSA_2048",
        "DomainValidationOptions": [
          {
            "DomainName": {
              "Ref": "DomainName"
            },
            "HostedZoneId": {
              "Ref": "HostedZoneId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze App Store"
          }
        ]
      }
    },
    "StoreOriginAccessControl": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4",
          "Description": "CloudFront-only access to private App Store objects."
        }
      }
    },
    "CatalogCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-catalog"
          },
          "Comment": "Always fetch the current catalog; retain offline caching in the native client.",
          "MinTTL": 0,
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "AssetCachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-assets"
          },
          "Comment": "Immutable, versioned packages and icons; never compressed.",
          "MinTTL": 0,
          "DefaultTTL": 86400,
          "MaxTTL": 31536000,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "EnableAcceptEncodingBrotli": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "StoreDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Glaze App Store catalog and installable packages",
          "Aliases": [
            {
              "Ref": "DomainName"
            }
          ],
          "DefaultRootObject": "catalog.txt",
          "IPV6Enabled": true,
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "StoreS3",
              "DomainName": {
                "Fn::GetAtt": [
                  "StoreBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "StoreOriginAccessControl"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "StoreS3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": false,
            "CachePolicyId": {
              "Ref": "CatalogCachePolicy"
            }
          },
          "CacheBehaviors": [
            {
              "PathPattern": "apps/*",
              "TargetOriginId": "StoreS3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": false,
              "CachePolicyId": {
                "Ref": "AssetCachePolicy"
              }
            }
          ],
          "ViewerCertificate": {
            "AcmCertificateArn": {
              "Ref": "StoreCertificate"
            },
            "SslSupportMethod": "sni-only",
            "MinimumProtocolVersion": "TLSv1.2_2021"
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 1
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 1
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "Glaze App Store"
          }
        ]
      }
    },
    "StoreBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "StoreBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontReadOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${StoreBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${StoreDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "RequireTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StoreBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${StoreBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "StoreDns": {
      "Type": "AWS::Route53::RecordSetGroup",
      "Properties": {
        "HostedZoneId": {
          "Ref": "HostedZoneId"
        },
        "Comment": "Glaze App Store CDN",
        "RecordSets": [
          {
            "Name": {
              "Ref": "DomainName"
            },
            "Type": "A",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "StoreDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          },
          {
            "Name": {
              "Ref": "DomainName"
            },
            "Type": "AAAA",
            "AliasTarget": {
              "DNSName": {
                "Fn::GetAtt": [
                  "StoreDistribution",
                  "DomainName"
                ]
              },
              "HostedZoneId": "Z2FDTNDATAQYW2",
              "EvaluateTargetHealth": false
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "StoreBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "StoreDistribution"
      }
    },
    "DistributionDomainName": {
      "Value": {
        "Fn::GetAtt": [
          "StoreDistribution",
          "DomainName"
        ]
      }
    },
    "StoreUrl": {
      "Value": {
        "Fn::Sub": "https://${DomainName}"
      }
    },
    "CertificateArn": {
      "Value": {
        "Ref": "StoreCertificate"
      }
    },
    "BucketOrigin": {
      "Value": {
        "Fn::GetAtt": [
          "StoreBucket",
          "RegionalDomainName"
        ]
      }
    }
  }
}
